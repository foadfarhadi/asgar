{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asgar",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "adb9bd2c-0746-47e4-b836-5f3e109dd801","database_name": "asgar" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0ec75f2a67a2440abef632e0818ed9d6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
